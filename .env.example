# Leave both unset for laptop/Wi-Fi or the single-service Render deployment.
# For a separate Netlify frontend, set these in Netlify before building:
# VITE_STATIC_HOST=true
# VITE_MULTIPLAYER_URL=wss://YOUR_GAME_SERVER/socket
# On that separate Node server, allow the exact frontend origin:
# ALLOWED_ORIGINS=https://YOUR_SITE.netlify.app

{
  "name": "crowns-of-the-frontier",
  "version": "2.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "art:build": "node scripts/blender/build.mjs",
    "art:balanced": "node scripts/blender/build-balanced.mjs",
    "art:bridge": "node scripts/blender/build-bridge.mjs",
    "art:materials": "node --use-system-ca scripts/vendor-materials.mjs",
    "art:characters": "node scripts/blender/build-character-surfaces.mjs",
    "art:horse": "node scripts/blender/build-horse-legs.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "three": "0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "playwright-core": "1.64.0",
    "vite": "^7.1.7"
  }
}
